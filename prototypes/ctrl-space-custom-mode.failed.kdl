// Research fixture expected to FAIL on Zellij 0.45.1:
// custom input modes are not supported.
//
// Desired sequence: Ctrl+Space -> Space.
keybinds clear-defaults=true {
    normal {
        bind "Ctrl Space" { SwitchToMode "pane-hud-leader"; }
        bind "Ctrl Shift q" { Quit; }
    }
    pane-hud-leader {
        bind "Space" {
            LaunchOrFocusPlugin "zellij:about" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "normal"
        }
        bind "Esc" { SwitchToMode "normal"; }
        bind "Ctrl c" { SwitchToMode "normal"; }
        bind "Ctrl Space" { SwitchToMode "normal"; }
    }
}
