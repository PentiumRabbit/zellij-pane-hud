// A launcher should sync Zellij's numeric plugin cache before a new server.
// Publish updates by pushing a v* tag; close and reopen to replace a live pane.
plugins {
    pane-switcher location="https://github.com/pr-g/zellij-pane-switcher/releases/latest/download/pane-switcher.wasm" {
        scope "all"
        row_format "{progress} {icon} {tab_id}-{pane_id}  {title}  {dir}  {command}"
        dir_depth "2"
        command_tail "2"
        colors {
            "{title}" "red"
            "{tab_id}-{pane_id}" "yellow"
            progress {
                running "red"
                idle "yellow"
                exited "green"
                unknown "red"
            }
        }
        icons "nerd"
        search_mode "fuzzy"
        spinner_fps "4"
    }
}

keybinds {
    // Preferred direct shortcut.
    shared_except "locked" {
        bind "Ctrl Shift e" {
            SwitchToMode "normal"
            LaunchOrFocusPlugin "pane-switcher" {
                floating true
                move_to_focused_tab true
            }
        }
    }

    // Fallback through Zellij's existing session leader: Ctrl+o, then g.
    session {
        bind "g" {
            LaunchOrFocusPlugin "pane-switcher" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "Normal"
        }
    }
}
