// The latest release is fetched whenever a new plugin pane is launched.
// Publish updates by pushing a v* tag; close and reopen to replace a live pane.
plugins {
    pane-switcher location="https://github.com/pr-g/zellij-pane-switcher/releases/latest/download/pane-switcher.wasm" {
        scope "all"
        row_format "{progress} {icon} {title}  {dir}  {session}/{tab}  {command}  #{pane_id}"
        icons "nerd"
        search_mode "fuzzy"
        spinner_fps "4"
    }
}

keybinds {
    // Preferred direct shortcut. skip_plugin_cache avoids stale remote plugins.
    shared_except "locked" {
        bind "Ctrl Shift e" {
            SwitchToMode "normal"
            LaunchOrFocusPlugin "pane-switcher" {
                floating true
                move_to_focused_tab true
                skip_plugin_cache true
            }
        }
    }

    // Fallback through Zellij's existing session leader: Ctrl+o, then g.
    session {
        bind "g" {
            LaunchOrFocusPlugin "pane-switcher" {
                floating true
                move_to_focused_tab true
                skip_plugin_cache true
            }
            SwitchToMode "Normal"
        }
    }
}
