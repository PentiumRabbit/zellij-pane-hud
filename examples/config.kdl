// Published automatically by the v* tag workflow.
plugins {
    pane-hud location="https://github.com/PentiumRabbit/zellij-pane-hud/releases/latest/download/pane-hud.wasm" {
        scope "all"
        row_format "{progress} {icon} {title}  {dir}  {session}/{tab}  {command}  #{pane_id}"
        icons "nerd"
        search_mode "fuzzy"
        spinner_fps "4"
    }
}

keybinds {
    // Preferred direct shortcut.
    shared_except "locked" {
        bind "Ctrl Shift e" {
            SwitchToMode "normal"
            LaunchOrFocusPlugin "pane-hud" {
                floating true
                move_to_focused_tab true
            }
        }
    }

    // Fallback through Zellij's existing session leader: Ctrl+o, then g.
    session {
        bind "g" {
            LaunchOrFocusPlugin "pane-hud" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "Normal"
        }
    }
}
